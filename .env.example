# URL oficial do grupo. Obrigatória antes do deploy.
NEXT_PUBLIC_WHATSAPP_GROUP_URL=

# URL pública canônica. Ex.: https://ofluxocerto.com.br
NEXT_PUBLIC_SITE_URL=

# Tracking opcional. A ausência não pode quebrar a página.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Disclosure opcional para parceria, corretora ou afiliação.
NEXT_PUBLIC_PARTNERSHIP_DISCLOSURE=
